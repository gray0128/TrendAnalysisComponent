+    const input = Array.from({ length: 10 }, (_, i) => i)
+    const result = capSeries(input)
+    expect(result.items.length).toBe(8)
+    expect(result.overflow).toBe(2)
+    expect(result.items).toEqual([0, 1, 2, 3, 4, 5, 6, 7])
+  })
+})
